{
  "ConnectionStrings": {
    "WorkerDatabase": ""
  },
  "WorkerRuntime": {
    "ShutdownDrainSeconds": 30,
    "ConsumerConcurrency": 1,
    "DatabasePoolSize": 32,
    "DatabaseCommandTimeoutSeconds": 30,
    "RabbitMqConnectionTimeoutSeconds": 10
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "",
    "Password": "",
    "VirtualHost": "/",
    "ClientProvidedName": "ecommerce-worker",
    "ExchangeName": "ecommerce.events",
    "QueueName": "ecommerce.worker.orders",
    "RetryExchangeName": "ecommerce.events.retry",
    "RetryQueueName": "ecommerce.worker.orders.retry",
    "DeadLetterExchangeName": "ecommerce.events.dlx",
    "DeadLetterQueueName": "ecommerce.worker.orders.dead",
    "DeliveryLimit": 5,
    "MaximumRetryAttempts": 3,
    "RetryDelaySeconds": 15,
    "ReconnectDelaySeconds": 5
  },
  "Email": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "UserName": "",
    "Password": "",
    "FromAddress": "no-reply@ecommerce.local",
    "FromName": "ECommerce",
    "TimeoutSeconds": 15
  },
  "NotificationProcessor": {
    "BatchSize": 20,
    "PollIntervalSeconds": 5,
    "LockSeconds": 60,
    "MaximumAttempts": 8
  },
  "ApiOutboxPublisher": {
    "Enabled": false,
    "BatchSize": 20,
    "PollIntervalSeconds": 5,
    "LockSeconds": 60,
    "MaximumAttempts": 8,
    "BaseRetryDelaySeconds": 5
  },
  "Observability": {
    "ServiceName": "ECommerce.Worker",
    "EnablePrometheus": true,
    "OtlpEndpoint": null
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
